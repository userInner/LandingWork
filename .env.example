# API Keys (comma-separated list of valid keys)
# Generate with: node -e "import('nanoid').then(m => console.log(m.nanoid(32)))"
API_KEYS=sk_test_your-api-key-here

# Resend (email verification)
RESEND_API_KEY=re_your_resend_api_key_here
FROM_EMAIL=SnapForge <hello@yourdomain.com>

# Rate limiting (requests per window)
RATE_LIMIT_MAX=200
RATE_LIMIT_WINDOW_MS=2592000000

# Playwright
MAX_CONCURRENT_BROWSERS=4
NAVIGATION_TIMEOUT_MS=30000

# Lemon Squeezy (for future webhook integration)
LEMONSQUEEZY_WEBHOOK_SECRET=
